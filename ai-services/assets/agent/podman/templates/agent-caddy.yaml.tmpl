apiVersion: v1
kind: Pod
metadata:
  name: "agent--caddy"
  labels:
    ai-services.io/component: "agent-proxy"
  annotations:
    # Expose the Caddy admin API on localhost only — reachable by the daemon
    # process on the host OS but not from outside the Worker LPAR.
    # Expose HTTPS on 8443 as a hostPort so the control-plane Caddy can
    # reverse-proxy to this Worker directly.
    ai-services.io/ports: "127.0.0.1:2019:2019, 8443:443"
spec:
  restartPolicy: always
  containers:
    - name: caddy
      image: "{{ .Values.caddy.image }}"
      imagePullPolicy: IfNotPresent
      args: ["caddy", "run", "--config", "/data/caddy/Caddyfile", "--resume"]
      env:
        - name: CADDY_ADMIN
          value: "0.0.0.0:2019"
      volumeMounts:
        - name: caddy-data
          mountPath: /data/caddy:z
        - name: caddy-config
          mountPath: /config:z
      resources:
        requests:
          memory: "256Mi"
        limits:
          memory: "512Mi"
      livenessProbe:
        httpGet:
          path: /health
          port: 8080
          scheme: HTTP
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 5
        failureThreshold: 3
  volumes:
    - name: caddy-data
      hostPath:
        path: {{ .BaseDir }}/agent/caddy
        type: DirectoryOrCreate
    - name: caddy-config
      hostPath:
        path: {{ .BaseDir }}/agent/caddy-config
        type: DirectoryOrCreate
