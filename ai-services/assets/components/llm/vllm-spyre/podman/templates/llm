apiVersion: v1
kind: Pod
metadata:
  name: llm-test
  annotations:
    io.podman.annotations.ulimit: "nofile=134217728:134217728,memlock=-1:-1"
    io.podman.annotations.userns: "keep-id"
    run.oci.keep_original_groups: "1"
spec:
  restartPolicy: always
  volumes:
    - name: dshm
      emptyDir:
        medium: Memory
        sizeLimit: 64Gi
    - name: models
      hostPath:
        path: /var/lib/ai-services/models
        type: Directory
  containers:
    - name: llm
      image: registry.redhat.io/rhaii/vllm-spyre-rhel9:3.5.0
      command: ["/bin/bash"]
      args:
        - "-c"
        - |
          exec /opt/app-root/spyre_entrypoint.sh \
          --model ${VLLM_MODEL_PATH} \
          -tp ${AIU_WORLD_SIZE} \
          --max-model-len ${MAX_MODEL_LEN} \
          --max-num-seqs ${MAX_BATCH_SIZE} \
          --served-model-name mistralai/Mistral-Small-3.2-24B-Instruct-2506 --port 8000
      livenessProbe:
        httpGet:
          path: /health
          port: 8000
        initialDelaySeconds: 420
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
      env:
        - name: VLLM_MODEL_PATH
          value: /models/mistralai/Mistral-Small-3.2-24B-Instruct-2506
        - name: AIU_WORLD_SIZE
          value: "4"
        - name: VLLM_SPYRE_USE_CB
          value: "1"
        - name: MAX_MODEL_LEN
          value: "32768"
        - name: MAX_BATCH_SIZE
          value: "32"
        - name: MASTER_PORT
          value: "12355"
      resources:
        requests:
          podman.io/device=/dev/vfio: 4
          memory: "200Gi"
        limits:
          memory: "200Gi"
      ports:
        - containerPort: 8000
          hostPort: 8000
      volumeMounts:
        - mountPath: /models:z
          name: models
          readOnly: true
        - mountPath: /dev/shm
          name: dshm